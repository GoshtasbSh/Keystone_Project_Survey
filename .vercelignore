# Local-only — don't upload to Vercel
venv/
__pycache__/
.git/
.claude/
.DS_Store
.env
*.pyc
*.pyo

# Heavy local data — never deployed. All runtime data comes from Supabase.
data/
output/
graphify-out/
mockups/
~$*
*.xlsx
*.gdb/

# FastAPI app runs only locally for ingestion; not deployed to Vercel.
app.py
keystone_field_api/

# Local-only ingestion scripts
scripts/

# Retired nested config
keystone_field_web/vercel.json

# CRITICAL — local Supabase CLI directory shadows the pip-installed `supabase`
# Python package on Vercel, causing "ImportError: cannot import name
# 'create_client' from 'supabase' (unknown location)". Migrations + edge
# functions are only needed locally for `supabase db push` / `supabase functions deploy`.
supabase/

# Local-only Python deps (geopandas/fiona/shapely/pandas/fastapi/uvicorn).
# Vercel reads the root `requirements.txt` (supabase only) for api/*.py.
requirements-local.txt

# Documentation, audit evidence and manuals — never executed at runtime and
# never routed. These are bundled into EVERY serverless function otherwise:
# in Sep 2026 they reached 195 MB and pushed the bundle past Vercel's 225 MB
# limit, failing the deploy.
docs/
final review/
user_manual/
tests/
.playwright-mcp/

# Internal notes at the repo root were publicly served as static files
# (audit 2026-10-13 DEP-9: /DEPLOY.md, /PARITY.md, /AUDIT_PHASE3.md,
# /PHASE1_DEPLOY.md, /PI_PRESENTATION.md, /REVIEW_STATUS.md all 200).
# Root-anchored so no deployed sub-directory is affected. requirements.txt
# must NOT be listed — Vercel installs the Python deps from it.
/*.md
/.env.example

# Local data that must never be uploaded by a CLI deploy (`vercel deploy`
# uploads the working tree, not git, and .gitignore does not apply here):
# runbook backups (scripts/prod_runbook.py backup — full contact list),
# hand-over exports, and screenshots of the signed-in dashboard dropped at
# the repo root. Nothing deployed references a root-level .png.
/backups/
/exports/
/*.png
.venv/

# Also local-only and gitignored, but .gitignore does not apply to a CLI
# deploy: verify/ holds local IAQ geojson with every response's health and
# housing answers at exact coordinates (what anonymous /api/iaq-points
# strips); .superpowers/ holds workflow briefs and review notes that name
# residents and give household addresses. Neither is referenced at runtime.
/verify/
/.superpowers/
.pytest_cache/
